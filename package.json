{
  "name": "legal-assistant",
  "version": "1.0.0",
  "description": "مساعد الردود للمستفيدين — نظام المرافعات الشرعية",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "node --test tests/*.test.js",
    "lint": "eslint js tests sw.js eslint.config.js",
    "format": "prettier --write \"{js,tests,css,data}/**/*\" \"*.{js,json,md,html}\"",
    "format:check": "prettier --check \"{js,tests}/**/*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.0.0"
  }
}
